# Copy to .env (project root) and fill in. Never commit .env.

APP_ENV=development
# Required in production. In development a random key is used if empty (sessions reset on restart).
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite by default. For PostgreSQL later: postgresql+psycopg://user:pass@localhost:5432/skills
# DATABASE_URL=

# Set to true when served over HTTPS
COOKIE_SECURE=false
MAX_UPLOAD_MB=5
FRONTEND_URL=http://localhost:5173
# Only needed if the frontend is NOT served through the Vite proxy / same origin
CORS_ORIGINS=

# Password-reset email. If SMTP_HOST is empty, reset links are printed in the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@skill-assessment.local

# AI (optional; the app works fully without it).
# Supported providers: none | anthropic | groq
#
# --- Groq (recommended: fast, free tier available) ---
# Get your key at: https://console.groq.com/keys
# Popular Groq models:
#   llama-3.3-70b-versatile   (best quality, recommended)
#   llama-3.1-8b-instant      (fastest, lowest latency)
#   mixtral-8x7b-32768        (long context)
#   gemma2-9b-it              (lightweight)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30

# --- Anthropic / Claude (alternative) ---
# Get your key at: https://console.anthropic.com
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-4-5
# AI_TIMEOUT_SECONDS=30
